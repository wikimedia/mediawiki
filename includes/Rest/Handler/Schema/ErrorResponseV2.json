			"example": 404
		},
		"message": {
			"type": "string",
			"x-i18n-description": "rest-openapispec-genericerrorresponse-property-desc-message",
			"example": "The specified page does not exist"
		},
		"messageTranslations": {
			"type": "object",
			"additionalProperties": { "type": "string" },
