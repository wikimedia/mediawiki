{
	"mwapi": "1.2.0",
	"moduleId": "content/v2-beta",
	"errorSchemaVersion": "2.0",
	"info": {
		"version": "1.0.0",
		"title": "Content API (Beta)",
		"x-i18n-title": "rest-module-content.v2-title",
		"x-i18n-description": "rest-module-content.v2-desc"
	},
	"externalDocs": {
		"description": "API documentation",
		"url": "https://www.mediawiki.org/wiki/API:REST_API"
	},
	"paths": {
		"/pages/{title}": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-page-title",
				"x-i18n-summary": "rest-endpoint-summ-content.v2-get-page-title",
				"handler": {
					"class": "MediaWiki\\Rest\\Handler\\PageHandler",
					"services": [
						"TitleFormatter",
						"PageRestHelperFactory"
					]
				}
			}
		},
		"/pages/{title}/html": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-page-title-html",
				"x-i18n-summary": "rest-endpoint-summ-content.v2-get-page-title-html",
				"handler": {
					"class": "MediaWiki\\Rest\\Handler\\PageHTMLHandler",
					"services": [
						"PageRestHelperFactory"
					]
				}
			}
		},
		"/revisions/{id}": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-revision-id",
				"x-i18n-summary": "rest-endpoint-summ-content.v2-get-revision-id",
				"handler": {
					"class": "MediaWiki\\Rest\\Handler\\RevisionHandler",
					"services": [
						"PageRestHelperFactory"
					]
				}
			}
		},
		"/revisions/{id}/html": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-revision-id-html",
				"x-i18n-summary": "rest-endpoint-summ-content.v2-get-revision-id-html",
				"handler": {
					"class": "MediaWiki\\Rest\\Handler\\RevisionHTMLHandler",
					"services": [
						"PageRestHelperFactory"
					]
				}
			}
		},
		"/pages:move/{from}": {
			"post": {
				"x-i18n-description": "rest-endpoint-desc-post-move-title",
				"x-i18n-summary": "rest-endpoint-summ-content.v2-post-move-title",
				"handler": {
					"adapter": {
						"type": "action",
						"action": "move",
						"suppressedParams": [ "fromid" ]
					}
				}
			}
		},
		"/pages:move": {
			"post": {
				"x-i18n-description": "rest-endpoint-desc-post-move",
				"x-i18n-summary": "rest-endpoint-summ-content.v2-post-move",
				"handler": {
					"adapter": {
						"type": "action",
						"action": "move"
					}
				}
			}
		},
		"/pages/{title}/backlinks": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-page-title-backlinks",
				"x-i18n-summary": "rest-endpoint-summ-content.v2-get-page-title-backlinks",
				"handler": {
					"adapter": {
						"type": "list",
						"list": "backlinks",
						"suppressedParams": [ "pageid" ]
					}
				}
			}
		}

	}
}
