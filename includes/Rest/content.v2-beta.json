{
	"mwapi": "1.2.0",
	"moduleId": "content/v2-beta",
	"errorSchemaVersion": "2.0",
	"info": {
		"version": "1.0.0",
		"title": "Content API",
		"x-i18n-title": "rest-module-content.v2-title",
		"x-i18n-description": "rest-module-content.v2-desc"
	},
	"externalDocs": {
		"description": "API documentation",
		"url": "https://www.mediawiki.org/wiki/API:REST_API"
	},
	"paths": {
		"/page/{title}": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-page-title",
				"handler": {
					"class": "MediaWiki\\Rest\\Handler\\PageHandler",
					"services": [
						"TitleFormatter",
						"PageRestHelperFactory"
					]
				}
			}
		},
		"/page/{title}/html": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-page-title-html",
				"handler": {
					"class": "MediaWiki\\Rest\\Handler\\PageHTMLHandler",
					"services": [
						"PageRestHelperFactory"
					]
				}
			}
		},
		"/revision/{id}": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-revision-id",
				"handler": {
					"class": "MediaWiki\\Rest\\Handler\\RevisionHandler",
					"services": [
						"PageRestHelperFactory"
					]
				}
			}
		},
		"/revision/{id}/html": {
			"get": {
				"x-i18n-description": "rest-endpoint-desc-get-revision-id-html",
				"handler": {
					"class": "MediaWiki\\Rest\\Handler\\RevisionHTMLHandler",
					"services": [
						"PageRestHelperFactory"
					]
				}
			}
		},
		"/page:move/{from}": {
			"post": {
				"x-i18n-description": "rest-endpoint-desc-post-move-title",
				"handler": {
					"adapter": {
						"type": "action",
						"action": "move"
					}
				}
			}
		},
		"/page:move": {
			"post": {
				"x-i18n-description": "rest-endpoint-desc-post-move",
				"handler": {
					"adapter": {
						"type": "action",
						"action": "move"
					}
				}
			}
		}

	}
}
